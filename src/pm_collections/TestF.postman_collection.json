                        {
                            "name": "Login_Right",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "type": "text/javascript",
                                        "exec": [
                                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                            "",
                                            "pm.test('Responde en menos de 1 segundo', () => {",
                                            "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                                            "});",
                                            "",
                                            "pm.test('El token tiene las tres partes del JWT', () => {",
                                            "    const token = pm.response.json().access_token;",
                                            "    pm.expect(token.split('.')).to.have.lengthOf(3);",
                                            "});",
                                            "",
                                            "pm.test('El cuerpo cumple el contrato', () => {",
                                            "    pm.response.to.have.jsonSchema({",
                                            "        type: 'object',",
                                            "        required: ['access_token', 'usuario'],",
                                            "        properties: {",
                                            "            access_token: { type: 'string' },",
                                            "            usuario: {",
                                            "                type: 'object',",
                                            "                required: ['id', 'email', 'nombre', 'rol'],",
                                            "                properties: {",
                                            "                    id: { type: 'number' },",
                                            "                    email: { type: 'string' },",
                                            "                    nombre: { type: 'string' },",
                                            "                    rol: { type: 'string' }",
                                            "                }",
                                            "            }",
                                            "        }",
                                            "    });",
                                            "});",
                                            "",
                                            "// Guarda el token para el resto de la suite",
                                            "if (pm.response.code === 200) {",
                                            "    pm.environment.set('token', pm.response.json().access_token);",
                                            "}"
                                        ]
